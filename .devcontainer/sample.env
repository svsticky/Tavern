HostUrl=https://localhost:5173
KeycloakUrl= # The base url of the keycloak provider
KeycloakRealm= # The name of the keycloak realm
KeycloakClientId= # The client ID of the keycloak client

BackendKeycloakClientId= # The client ID of the keycloak client for the backend authentication
KeycloakClientSecret= # The client secret for the backend authentication
MollieApiKey= # The mollie api key

ApiUrl=https://localhost:8081 # The base url of the backend API, used for making API requests from the frontend during development. This should point to the local development server for the backend, e.g., http://localhost:8081, and should be updated to the production URL when deploying to production.

AWS_ACCESS_KEY_ID=test # test for development, use real credentials in production
AWS_SECRET_ACCESS_KEY=test # test for development, use real credentials in production
AWS_REGION=us-east-1 # The AWS region where your S3 bucket is located, e.g., us-east-1
S3_SERVICE_URL=http://localstack:4566 # The URL for the S3 service, e.g., http://localhost:4566 for localstack

BOARD_GROUP_ID=1 # The ID of the board group in Keycloak, used for authorization purposes

MOLLIE_FEE=0.39 # The fixed fee charged by Mollie per transaction, used to calculate the total amount to charge customers to cover the fee and prevent underpayment. This value is added to the total price of the activities when creating a payment request to ensure that the amount charged to customers includes the Mollie fee.

NGROK_AUTHTOKEN= # The authentication token for ngrok, used to authenticate your ngrok account when creating tunnels to expose your local development server to the internet. This allows you to test webhooks and other integrations that require a publicly accessible URL during development.

BACKUP_ACCOUNT_EMAIL= # The email address used to create a board account if there are no board accounts. 

# FOR SMTP MAILING:
# MAIL_SERVICE=SMTP # The mail service to use for sending emails, e.g., SMTP for using an SMTP server, or MAILGUN for using the Mailgun API. This should be set based on your email sending preferences and the services you have set up for sending emails in your application.
# SMTP_HOST= # The hostname of the SMTP server, used for sending emails through an SMTP service.
# SMTP_PORT=587 # The port number of the SMTP server, typically 587 for secure submission, used for sending emails through an SMTP service.
# SMTP_STARTTLS=true # Whether to use STARTTLS for the SMTP connection, set to true to enable STARTTLS for secure email transmission, or false to disable it. This should be set based on the requirements of your SMTP server and security preferences.
# SMTP_USER= # The username for authenticating with the SMTP server, used for sending emails through an SMTP service that requires authentication.
# SMTP_PASS= # The password for authenticating with the SMTP server, used for sending emails through an SMTP service that requires authentication. This should be kept secure

# MAIL_SERVICE=MAILGUN # The mail service to use for sending emails, e.g., MAILGUN 
# MAILGUN_TOKEN= # The API token for Mailgun, used for authentication when sending emails through the Mailgun service. This token should be kept secure and not exposed in public repositories.
# MAILGUN_PUBLIC_KEY= # The public API key for Mailgun, used for client-side operations if needed. This key is typically used for certain Mailgun features that require a public key, but may not be necessary for basic email sending functionality.
# MAILGUN_API_BASE_URL= # The base URL for the Mailgun API, used to specify the endpoint for API requests when sending emails through Mailgun. This is typically in the format https://api.mailgun.net/v3/your-domain.com, where your-domain.com is the domain you have set up with Mailgun for sending emails.

# ACCOUNTING_SERVICE=EXACT # Set to true if you want to enable integration with the Exact API, false otherwise
# EXACT_ACCESS_TOKEN= # The access token for the Exact API, used for authentication when making requests to Exact
# EXACT_DIVISION= # The division code for the Exact API, used to specify which division to interact with when making requests to Exact
# EXACT_MEMBERSHIP_GL_ACCOUNT= # The general ledger account code for membership payments in Exact, used when creating sales entries for membership payments
# MOLLIE_FEE_GL_ACCOUNT= # The general ledger account code for recording Mollie fees in the accounting system, used when creating sales entries for the Mollie fee in Exact or another accounting tool.

# ROLEMAILMAP_[ROLE_ID]=[EMAIL_ADDRESS] # Environment variables that map Keycloak role IDs to email addresses for sending notifications. For example,


