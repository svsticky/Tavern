# ==============================================================================
# TAVERN CORE CONFIGURATION (Ports & Hosts)
# ==============================================================================
FrontendPort=5173
BackendPort=8080
DocsPort=8081
HostUrl=http://localhost:5173
ApiUrl=http://localhost:8080

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
PostgresqlConnectionString="Host=db;Username=postgres;Password=postgres;Database=postgres"

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
# Auth System (Keycloak) - Uncomment to enable
AUTH_SYSTEM=KEYCLOAK
# KeycloakUrl=
# KeycloakRealm=
# KeycloakClientId=
# KeycloakBackendClientId=
# KeycloakClientSecret=
# AUTH_WEBHOOK_SECRET=

# ==============================================================================
# PAYMENTS & ACCOUNTING
# ==============================================================================
PAYMENT_PROVIDER=MOLLIE
MollieApiKey=
BACKUP_ACCOUNT_EMAIL=

# Accounting (EXACT) - Uncomment to enable
# ACCOUNTING_SERVICE=EXACT
# EXACT_ACCESS_TOKEN=
# EXACT_DIVISION=

# ==============================================================================
# THEME & UI CUSTOMIZATION (Vite)
# ==============================================================================
LOGO_URL=
BOARD_PRIMARY_LIGHT="#f98f55ff"
BOARD_PRIMARY="#fa6b20"
BOARD_PRIMARY_DARK="#ca5617""

# ==============================================================================
# INFRASTRUCTURE & STORAGE (AWS/S3)
# ==============================================================================
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_SERVICE_URL=http://localstack:4566

# ==============================================================================
# MAIL SERVICES (Choose one: SMTP, MAILGUN)
# ==============================================================================
MAIL_SERVICE=SMTP

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASS=

# Mailgun Configuration
# MAILGUN_TOKEN=
# MAILGUN_PUBLIC_KEY=
# MAILGUN_API_BASE_URL=

# ==============================================================================
# EXTERNAL INTEGRATIONS (Mailchimp, Ngrok)
# ==============================================================================
# Mailchimp
# MAIL_SUBSCRIPTION_SERVICE=MAILCHIMP
# MAILCHIMP_LIST_KEY=
# MAILCHIMP_API_KEY=

# Ngrok (Development only)
NGROK_AUTHTOKEN=
NGROK_URL=
